/* ============================================================
   tui.tcss  —  Dark Hour Dashboard  (Persona 3 × GTA aesthetic)
   Color story:
     Background  #060615  — near-black, cold
     Surface     #0a0a1e  — dark navy
     Border      #1e3a5f  — deep steel (base state)
     Blue accent #4682b4  — steel blue (focus/hover)
     Warm accent #e8a020  — amber gold (active, badges)
     Green       #00c040  — completion
     Red         #c03040  — error
   ============================================================ */

/* ── Global ─────────────────────────────────────────────── */

Screen {
    background: #060615;
}

.hidden {
    display: none;
}

/* ── Dashboard: header ───────────────────────────────────── */

DashboardHeader {
    height: 7;
    border: double #1e3a5f;
    content-align: center middle;
    padding: 0 2;
}

/* ── Dashboard: body ─────────────────────────────────────── */

#body {
    height: 1fr;
}

NavSidebar {
    width: 22;
    border: double #1e3a5f;
    padding: 1 2;
    layout: vertical;
}

#nav-items {
    height: 1fr;
}

#nav-watermark {
    height: 2;
    text-align: left;
}

#main {
    width: 1fr;
}

#upper {
    height: 1fr;
}

#lower {
    height: 1fr;
}

/* ── Dashboard: HUD cards ─────────────────────────────────── */

HabitsWidget {
    width: 1fr;
    border: double #1e3a5f;
    padding: 0 1;
    content-align: center middle;
}

TasksWidget {
    width: 1fr;
    border: double #1e3a5f;
    padding: 0 1;
    content-align: center middle;
}

NotesWidget {
    width: 1fr;
    border: double #1e3a5f;
    padding: 0 1;
    content-align: center middle;
}

PortfolioWidget {
    width: 1fr;
    border: double #1e3a5f;
    padding: 0 1;
    content-align: center middle;
}

/* ── Dashboard: footer ───────────────────────────────────── */

#footer {
    height: 3;
    border: round #1e3a5f;
    color: #5f87af;
    content-align: center middle;
    text-style: italic;
}

#footer-controls {
    height: 1;
    content-align: center middle;
    color: #2a3a5a;
}

/* ── Sub-screens: shared ─────────────────────────────────── */

.sub-title {
    height: 3;
    border: double #1e3a5f;
    content-align: center middle;
    text-style: bold;
    color: #f0f0ff;
}

.sub-msg {
    height: 2;
    padding: 0 1;
    color: #f0f0ff;
}

.sub-hint {
    height: 1;
    content-align: center middle;
    color: #2a3a5a;
    text-style: dim;
}

/* ── DataTable ───────────────────────────────────────────── */

DataTable {
    height: 1fr;
    border: double #1e3a5f;
    background: #060615;
}

DataTable > .datatable--header {
    background: #0a0a1e;
    color: #e8a020;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #1a1a3a;
    color: #f0f0ff;
}

DataTable > .datatable--hover {
    background: #0d0d28;
}

/* ── Input ───────────────────────────────────────────────── */

Input {
    border: double #1e3a5f;
    background: #0a0a1e;
    color: #f0f0ff;
}

Input:focus {
    border: double #e8a020;
}

/* ── Notes: scroll container ─────────────────────────────── */

#notes-scroll {
    height: 1fr;
    border: double #1e3a5f;
    background: #060615;
    padding: 0 1;
}

/* ── Music: dual inputs ──────────────────────────────────── */

#music-inputs {
    height: 3;
}

#music-inputs Input {
    width: 1fr;
}

/* ── Game screen ─────────────────────────────────────────── */

#game-prompt {
    height: 1fr;
    border: double #1e3a5f;
    content-align: center middle;
    text-align: center;
    color: #f0f0ff;
}

/* ── Bot HUD card ─────────────────────────────────────────── */

#bot-widget {
    height: 5;
    border: double #1a3a5a;
    padding: 0 1;
    content-align: center middle;
    color: #4a9eff;
}

/* ── Bots screen ──────────────────────────────────────────── */

#bots-title {
    height: 3;
    border: double #1a3a5a;
    content-align: center middle;
    text-style: bold;
    color: #f0f0ff;
}

#bots-body {
    height: 1fr;
}

#bots-history {
    width: 2fr;
    border: double #1e3a5f;
    background: #060615;
    padding: 0 1;
}

#history-content {
    color: #f0f0ff;
}

#bots-right {
    width: 3fr;
    border: double #1a3a5a;
    padding: 0 1;
}

#pending-header {
    height: 2;
    content-align: left middle;
    color: #e8a020;
    text-style: bold;
}

#pending-content {
    height: 1fr;
    color: #f0f0ff;
}

#pending-hint {
    height: 2;
    content-align: center middle;
    color: #e8a020;
}

#watcher-bar {
    height: 1;
    content-align: center middle;
    color: #2a3a5a;
    background: #040410;
}

#bots-keyhint {
    height: 1;
    content-align: center middle;
    color: #2a3a5a;
    text-style: dim;
}
